# Set these in Netlify: Site configuration → Environment variables. Never commit real values.
RESEND_API_KEY=re_xxxxxxxx              # Resend API key (email notifications)
MAIL_FROM=Sociam <notifications@sociam.in>  # Sender on a domain verified in Resend
NOTIFY_TO=venkateshprasadnc@gmail.com   # Where enquiry notifications go
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx       # Ask Sociam
ANTHROPIC_MODEL=claude-sonnet-5-5       # Optional; claude-haiku-5-5 is cheaper and faster
ASK_WEB_SEARCH=0                        # Optional; 1 lets Ask Sociam search the web for current questions
ADMIN_PASSWORD=choose-a-long-passphrase # Pipeline sign-in at /admin/
SESSION_SECRET=another-long-random-string
RATE_SALT=any-random-string
